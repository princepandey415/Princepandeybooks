@charset "utf-8";

* { box-sizing: border-box; }

body { margin: 0px; font-family: Inter, Arial, sans-serif; background: rgb(245, 245, 245); color: rgb(23, 23, 23); }

header { background: linear-gradient(135deg, rgb(17, 17, 17), rgb(41, 41, 41)); color: rgb(255, 255, 255); padding: 42px 18px; text-align: center; }

header h1 { margin: 0px 0px 8px; font-size: 34px; }

header p { margin: 0px; color: rgb(221, 221, 221); font-size: 16px; }

.container { max-width: 1050px; margin: auto; padding: 24px 16px 50px; }

.books { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 22px; }

.card { background: rgb(255, 255, 255); border-radius: 18px; overflow: hidden; box-shadow: rgba(0, 0, 0, 0.09) 0px 8px 25px; }

.card img { width: 100%; display: block; aspect-ratio: 1 / 1; object-fit: cover; }

.card-body { padding: 18px; }

.card h2 { margin: 0px 0px 10px; font-size: 22px; }

.card p { color: rgb(102, 102, 102); line-height: 1.5; }

.btn { display: block; width: 100%; border: 0px; border-radius: 12px; padding: 14px; background: rgb(17, 17, 17); color: rgb(255, 255, 255); font-size: 16px; font-weight: 700; cursor: pointer; }

.section { background: rgb(255, 255, 255); border-radius: 18px; padding: 22px; margin-top: 24px; box-shadow: rgba(0, 0, 0, 0.07) 0px 8px 25px; }

.section h2 { margin-top: 0px; }

label { display: block; font-weight: 700; margin: 13px 0px 7px; }

input, select, textarea { width: 100%; padding: 13px; border: 1px solid rgb(221, 221, 221); border-radius: 10px; font-size: 15px; }

textarea { min-height: 90px; resize: vertical; }

.notice { background: rgb(255, 248, 230); border-left: 4px solid rgb(224, 161, 0); padding: 12px 14px; border-radius: 8px; line-height: 1.5; }

.qr { display: block; width: min(100%, 380px); margin: 12px auto; border-radius: 12px; }

.whatsapp { background: rgb(18, 140, 126); margin-top: 12px; }

.small { font-size: 13px; color: rgb(102, 102, 102); }

footer { text-align: center; padding: 25px; color: rgb(119, 119, 119); }
