<!DOCTYPE html><html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-8cf56e4d-abf8-4d6f-b390-3bc047f7dbd2@mhtml.blink" />

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#111111">
<title>Prince Pandey — Books</title>

</head>
<body>

<header>
  <h1>📚 Books by Prince Pandey</h1>
  <p>Order your copy directly</p>
</header>

<div class="container">
  <div class="books">
    <div class="card">
      <img src="data:image/jpeg;base64," alt="When Your Soul Left Mine">
      <div class="card-body">
        <h2>When Your Soul Left Mine</h2>
        <p>A novel by Prince Pandey.</p>
        <button class="btn">Order This Book</button>
      </div>
    </div>

    <div class="card">
      <img src="data:image/jpeg;base64," alt="Learning to Live Alone">
      <div class="card-body">
        <h2>Learning to Live Alone</h2>
        <p>The life I built after everyone left — a novel by Prince Pandey.</p>
        <button class="btn">Order This Book</button>
      </div>
    </div>
  </div>

  <div class="section" id="order">
    <h2>🛒 Place Your Order</h2>
    <div class="notice">
      Fill in your details and tap <b>Send Order on WhatsApp</b>. Your order will be sent directly to the customer-service WhatsApp number.
      <br><b>Payment:</b> Confirm your order first, then pay using the QR below.
    </div>

    <form>
      <label>Book</label>
      <select id="book" required="">
        <option value="">Select a book</option>
        <option>When Your Soul Left Mine</option>
        <option>Learning to Live Alone</option>
      </select>

      <label>Quantity</label>
      <input id="qty" type="number" min="1" value="1" required="">

      <label>Your Name</label>
      <input id="name" type="text" placeholder="Enter your full name" required="">

      <label>WhatsApp / Mobile Number</label>
      <input id="phone" type="tel" placeholder="10-digit mobile number" required="">

      <label>Delivery Address</label>
      <textarea id="address" placeholder="House/Flat, Street, City, State, PIN" required=""></textarea>

      <label>Payment Status</label>
      <select id="payment" required="">
        <option value="">Select payment status</option>
        <option value="Paid via PhonePe">Paid via PhonePe</option>
      </select>

      <label>Transaction ID / UTR (optional)</label>
      <input id="utr" type="text" placeholder="Enter PhonePe UTR / Transaction ID" required="">

      <button class="btn whatsapp" type="submit">📲 Send Order on WhatsApp</button>
      <p class="small"><b>Important:</b> Order is treated as confirmed only after payment and UTR are checked by us.</p>
    </form>
  </div>

  <div class="section">
    <h2>💳 Pay via PhonePe</h2>
    <p><b>Step 1:</b> Scan and pay using PhonePe. <b>Step 2:</b> Enter the UTR/Transaction ID above. <b>Step 3:</b> Send the order on WhatsApp. We will verify the payment and then confirm the order.</p>
    <img class="qr" src="data:image/png;base64," alt="PhonePe payment QR code">
    <p style="text-align:center"><b>Customer Service: +91 84097 34280</b></p>
  </div>

  <div class="section">
    <h2>📞 Need Help?</h2>
    <p>WhatsApp us for order confirmation, payment help or delivery questions.</p>
    <a class="btn whatsapp" href="https://wa.me/918409734280?text=Hello%20Prince%20Pandey%2C%20I%20need%20help%20with%20a%20book%20order." target="_blank">WhatsApp Customer Service</a>
  </div>
</div>

<footer>© 2026 Prince Pandey · Books &amp; Orders</footer>




</body></html>
